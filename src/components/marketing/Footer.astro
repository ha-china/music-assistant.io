---
import { withBase } from "../../lib/base";
import Logo from "./ui/Logo.astro";

const columns = [
  {
    title: "产品",
    links: [
      { href: "/get-started/", label: "快速开始" },
      { href: "/music-providers/", label: "音乐源" },
      { href: "/player-support/", label: "播放器" },
      { href: "/plugins/", label: "插件" },
    ],
  },
  {
    title: "学习",
    links: [
      { href: "/documentation/", label: "文档" },
      { href: "/blog/", label: "新闻" },
      { href: "/faq/troubleshooting/", label: "故障排查" },
      { href: "/support/", label: "支持" },
    ],
  },
  {
    title: "社区",
    links: [
      { href: "https://github.com/music-assistant", label: "GitHub" },
      { href: "https://discord.gg/kaVm8hGpne", label: "Discord" },
      { href: "/help/", label: "帮助 / 捐赠" },
      { href: "/help/lokalise/", label: "参与翻译" },
    ],
  },
];
const isExternal = (href: string) => href.startsWith("http");
---

<footer class="site-footer tone-alt">
  <div class="container">
    <div class="top">
      <div class="about">
        <a href={withBase("/")} class="home" aria-label="Music Assistant 首页">
          <Logo />
        </a>
        <p>
          你的音乐，由你做主。免费开源，Open Home Foundation 旗下项目。
        </p>
        <a
          class="ohf"
          href="https://www.openhomefoundation.org/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="https://www.openhomefoundation.org/badges/ohf-project.png"
            alt="A project from the Open Home Foundation"
            width="300"
            height="80"
            loading="lazy"
          />
        </a>
      </div>
      {columns.map((column) => (
        <nav aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={isExternal(link.href) ? "_blank" : undefined}
                  rel={
                    isExternal(link.href) ? "noopener noreferrer" : undefined
                  }
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <div class="bottom">
      <p>© {new Date().getFullYear()} Open Home Foundation</p>
      <p class="analytics">
        <a
          href="https://www.openhomefoundation.org/blog/making-our-web-analytics-open-source-with-plausible/"
          rel="noopener"
        >
          Privacy-first analytics
        </a>
        <span aria-hidden="true">·</span>
        <a
          href="https://plausible.openhomefoundation.org/music-assistant.io"
          rel="noopener"
        >
          Public dashboard
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }
  .top {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 2.5rem;
  }
  .home {
    display: block;
    height: 1.75rem;
    margin-bottom: 1rem;
    color: var(--fg);
  }
  .about p {
    max-width: 32ch;
    color: var(--muted);
  }
  .ohf img {
    width: 11rem;
  }
  h2 {
    margin-bottom: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    text-decoration: none;
  }
  ul a:hover {
    color: var(--link);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .bottom p {
    margin: 0;
  }
  .analytics {
    display: flex;
    gap: 0.5rem;
  }
  @media (max-width: 800px) {
    .top {
      grid-template-columns: repeat(3, 1fr);
    }
    .about {
      grid-column: 1 / -1;
    }
    .ohf img {
      width: 18.75rem;
    }
  }
  @media (max-width: 480px) {
    .top {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
